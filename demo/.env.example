# Local-only service endpoints inside Docker Compose
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=local-demo-change-me
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_NUM_PREDICT=256
OLLAMA_TRANSLATION_NUM_PREDICT=96
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_MODEL=glm-5.3
ZAI_NUM_PREDICT=512
MAX_HOPS=4
MAX_PATHS=30
TOP_K_PATHS=3
RANKER_PATH=/app/models/xgb_ranker.json

# ---- LLM provider cho pipeline (predict/relevance/translate/describe) ----
# ollama = raw /api/generate (mặc định cũ) | openai = endpoint tương thích
# OpenAI /chat/completions: Ollama /v1, vLLM, LM Studio, OpenRouter, Together...
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=
# Với server local không cần key; nếu provider yêu cầu, đặt key vào biến môi
# trường named dưới đây (không ghi key vào file này).
LLM_API_KEY_ENV=LLM_API_KEY
LLM_NUM_PREDICT=512

# ---- Prompt classify ----
# demo = prompt JSON có explanation | paper = template tcma của repo chính
# (cặp + context + top-k relation paths, trả đúng 1 từ causal/non-causal)
CAUSAL_PROMPT_STYLE=demo
PAPER_TASK=comagc
PAPER_STYLE=mistral

# ---- Ranker train bởi repo chính (m2_train_ranker.py) ----
# 1) Cross-encoder ce_* (--save-model): thư mục chứa các model_best_<task>_<ranker>_<ts>/
#    (model.safetensors + tokenizer). Tự chọn model có NDCG@5 test cao nhất.
#    Cần pip install -r requirements-ce.txt (torch+transformers) trong môi trường chạy
#    Streamlit; nếu thiếu thư viện -> tự bỏ qua, dùng ranker kế tiếp.
REPO_CE_DIR=models/ce
# 2) XGBoost + n-gram (--rankers xgboost): copy artifact bằng
#    python scripts/import_repo_ranker.py
REPO_RANKER_DIR=/app/models/repo_ranker

