.git
.gitignore
.env
.venv
__pycache__
**/__pycache__
*.py[cod]
.pytest_cache
data/raw/*
!data/raw/.gitkeep
data/benchmark/*.csv
!data/benchmark/.gitkeep
models/*.json
!models/.gitkeep
# Checkpoint lớn không nướng vào image: docker-compose đã mount ./models:/app/models
# nên /app/models/ce và /app/models/repo_ranker vẫn có tại runtime.
models/ce/
models/repo_ranker/
results/*
!results/.gitkeep
