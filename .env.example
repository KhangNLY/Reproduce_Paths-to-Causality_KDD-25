# Sao chép file này thành ".env" (cùng thư mục) rồi điền key thật. File ".env" đã nằm trong .gitignore.
# KHÔNG commit/đẩy/gửi file .env cho người khác.
OPENROUTER_API_KEY=sk-or-điền-key-vào-đây
# HF_TOKEN=hf_...          # chỉ cần cho model gated của HuggingFace (Llama-3, Gemma) với --backend hf
# OPENAI_API_KEY=sk-...    # nếu dùng trực tiếp OpenAI

